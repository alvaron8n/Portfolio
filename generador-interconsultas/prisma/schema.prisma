// =============================================================================
// GENERADOR DE INTERCONSULTAS - SCHEMA PRISMA
// =============================================================================
// Este schema define la estructura de base de datos para el SaaS.
//
// CONFIGURACIÓN:
// - Desarrollo: SQLite (archivo local)
// - Producción: PostgreSQL
//
// Para cambiar a PostgreSQL, modificar:
//   provider = "postgresql"
//   url      = env("DATABASE_URL")  // postgresql://user:pass@host:5432/db
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// AUTENTICACIÓN Y USUARIOS
// =============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          String    @default("MEDICO") // SUPERADMIN, ADMIN_CLINICA, MEDICO

  // Relación con clínica
  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id])

  // Datos profesionales (médico)
  numeroColegiado String?
  especialidad    String?

  // Preferencias de usuario
  preferences   String?   // JSON con preferencias UI

  // Metadata
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  isActive      Boolean   @default(true)

  // Relaciones
  documents     Document[]
  auditLogs     AuditLog[]

  @@index([clinicId])
  @@index([email])
}

// =============================================================================
// MULTI-TENANT: CLÍNICAS
// =============================================================================

model Clinic {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique  // identificador URL-friendly

  // Datos de la clínica
  nif         String?           // CIF/NIF
  address     String?
  city        String?
  postalCode  String?
  phone       String?
  email       String?
  website     String?

  // Configuración general (JSON)
  settings    String   @default("{}")

  // Plan y límites
  plan        String   @default("FREE") // FREE, BASIC, PROFESSIONAL, ENTERPRISE
  maxUsers    Int      @default(5)
  maxDocsMonth Int     @default(100)
  aiEnabled   Boolean  @default(false)
  webhooksEnabled Boolean @default(false)

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  // Relaciones
  users       User[]
  services    Service[]
  templates   Template[]
  documents   Document[]
  webhooks    Webhook[]
  auditLogs   AuditLog[]

  @@index([slug])
}

// =============================================================================
// SERVICIOS DESTINO
// =============================================================================

model Service {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  name        String
  category    String?  // Categoría: Especialidad, Soporte, etc.
  description String?

  // Ordenación y estado
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clinicId, name])
  @@index([clinicId])
  @@index([clinicId, isActive])
}

// =============================================================================
// PLANTILLAS DE DOCUMENTOS
// =============================================================================

model Template {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  // Tipo de documento
  type        String   // INTERCONSULTA, INFORME_ALTA, PETICION_PRUEBAS, etc.

  // Datos de la plantilla
  name        String
  description String?
  content     String   // Texto con {{placeholders}}

  // Configuración de campos (JSON)
  // Define qué campos son requeridos/opcionales para este tipo
  fieldsConfig String  @default("[]")

  // Estado y versión
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  version     Int      @default(1)

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  // Relaciones
  documents   Document[]

  @@unique([clinicId, type, name])
  @@index([clinicId, type])
  @@index([clinicId, isActive])
}

// =============================================================================
// DOCUMENTOS GENERADOS
// =============================================================================

model Document {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  // Tipo y plantilla
  type        String   // INTERCONSULTA, INFORME_ALTA, etc.
  templateId  String
  template    Template @relation(fields: [templateId], references: [id])

  // Contenido
  // IMPORTANTE: formData NO debe contener datos identificables del paciente
  // Solo usar iniciales, edad, sexo - nunca NHC, DNI, nombre completo
  formData      String   // JSON con datos del formulario (anonimizables)
  generatedText String   // Texto generado
  enhancedText  String?  // Texto mejorado por IA (si aplica)

  // Usuario que creó el documento
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  // Tracking de uso
  wasEnhanced Boolean  @default(false)
  wasPrinted  Boolean  @default(false)
  wasCopied   Boolean  @default(false)

  // Metadata
  createdAt   DateTime @default(now())

  @@index([clinicId, createdAt])
  @@index([createdById])
  @@index([type])
  @@index([clinicId, type])
}

// =============================================================================
// WEBHOOKS PARA INTEGRACIONES (n8n, Zapier, etc.)
// =============================================================================

model Webhook {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  // Configuración
  name        String
  url         String
  secret      String?  // Para firmar requests (HMAC)
  headers     String?  // JSON con headers adicionales

  // Eventos que disparan el webhook (JSON array)
  // Ejemplos: ["document.created", "document.enhanced", "user.login"]
  events      String   @default("[]")

  // Configuración de reintentos
  isActive    Boolean  @default(true)
  retryCount  Int      @default(3)
  timeoutMs   Int      @default(5000)

  // Estadísticas
  lastTriggeredAt DateTime?
  successCount    Int      @default(0)
  failureCount    Int      @default(0)
  lastError       String?

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clinicId])
  @@index([clinicId, isActive])
}

// =============================================================================
// AUDIT LOG - REGISTRO DE AUDITORÍA
// =============================================================================

model AuditLog {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  // Usuario que realizó la acción (puede ser null para acciones del sistema)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  // Acción realizada
  action      String   // document.create, template.update, user.login, etc.
  resource    String   // document, template, service, user, etc.
  resourceId  String?  // ID del recurso afectado

  // Detalles adicionales (JSON)
  details     String?  // Datos antes/después, contexto adicional

  // Información de la request
  ipAddress   String?
  userAgent   String?

  // Timestamp
  createdAt   DateTime @default(now())

  @@index([clinicId, createdAt])
  @@index([userId])
  @@index([action])
  @@index([resource, resourceId])
}

// =============================================================================
// SESIONES (para NextAuth)
// =============================================================================

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
